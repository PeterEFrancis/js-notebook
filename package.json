{
  "name": "js-notebook",
  "version": "0.1.0",
  "description": "Lightweight JavaScript notebook",
  "main": "dist/js-notebook.cjs",
  "module": "dist/js-notebook.esm.js",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/js-notebook.esm.js",
      "require": "./dist/js-notebook.cjs"
    },
    "./style.css": "./dist/style.css"
  },
  "engines": {"node": ">=20"},
  "files": ["dist", "LICENSE", "readme.md"],
  "scripts": {
    "build": "rollup -c",
    "test": "node --test"
  },
  "keywords": [
    "notebook",
    "javascript",
    "editor"
  ],
  "author": "Peter Francis",
  "license": "MIT",
  "devDependencies": {
    "@rollup/plugin-commonjs": "^28.0.3",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-terser": "^1.0.2",
    "postcss": "^8.5.3",
    "postcss-import": "^16.1.0",
    "postcss-url": "^10.1.3",
    "rollup": "^4.39.0",
    "rollup-plugin-copy": "^3.5.0",
    "rollup-plugin-postcss": "^4.0.2"
  },
  "dependencies": {
    "@popperjs/core": "^2.11.8",
    "bootstrap": "^5.3.5",
    "bootstrap-icons": "^1.11.3",
    "codemirror": "^5.65.19",
    "file-saver": "^2.0.5"
  }
}
